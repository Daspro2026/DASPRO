rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'siswa';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama','kelasId','nis','deskripsi','foto']));
      allow delete: if isAdmin();
    }
    match /kelas/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /mapel/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /meta/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /materi/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /tugas/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /kuis/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    // Kunci jawaban: HANYA admin. Siswa tidak bisa membaca sama sekali.
    match /kunci/{id}  { allow read, write: if isAdmin(); }
    // File jawaban siswa (maks ~700 KB, disimpan sebagai teks base64). Hanya pemilik & guru yang boleh membaca.
    match /berkas/{id} {
      allow create: if signedIn() && request.resource.data.siswaId == request.auth.uid
                    && request.resource.data.data is string && request.resource.data.data.size() < 980000;
      allow read: if isAdmin() || (signedIn() && resource.data.siswaId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /submissions/{id} {
      allow create: if signedIn() && request.resource.data.siswaId == request.auth.uid
                    && request.resource.data.status == 'belum_diperiksa'
                    && request.resource.data.nilai == null;
      allow read: if isAdmin() || (signedIn() && resource.data.siswaId == request.auth.uid);
      allow update: if isAdmin();
    }
  }
}
