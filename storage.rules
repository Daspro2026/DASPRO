rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // File dari guru (materi, dll)
    match /files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Jawaban siswa: hanya pemilik dan guru yang boleh membaca. Maks 10 MB, jenis file dibatasi.
    match /jawaban/{uid}/{tugasId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-(excel|powerpoint)|text/plain|text/csv|image/(png|jpeg|webp)|application/(zip|x-zip-compressed)');
      allow delete: if isAdmin();
    }
  }
}
